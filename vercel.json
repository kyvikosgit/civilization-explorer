{
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "app.it-ta.com"
        }
      ],
      "dest": "https://civilization-explorer-app.vercel.app/$1"
    },
    {
      "src": "/.well-known/apple-app-site-association",
      "headers": {
        "Content-Type": "application/json"
      },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.it-ta.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://it-ta.com/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.monet100.com"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://monet100.com/$1"
      }
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "monet100.com"
        }
      ],
      "dest": "/monet100-web/index.html"
    },
    {
      "src": "/admin/tickets/?",
      "dest": "/admin/tickets/index.html"
    },
    {
      "src": "/invita(t?)ion/admin/?",
      "dest": "/invitation/admin/index.html"
    },
    {
      "src": "/(invita(t?)ion/)?press/?",
      "dest": "/invitation/press/index.html"
    },
    {
      "src": "/invita(t?)ion/vip/?",
      "dest": "/invitation/index.html"
    },
    {
      "src": "/invita(t?)ion/?",
      "dest": "/invitation/index.html"
    },
    {
      "src": "/z/[^/]+/?",
      "dest": "/z/index.html"
    },
    {
      "src": "/live/?",
      "dest": "/design/experience-v3/nadar-live.html"
    },
    {
      "src": "/frame/?",
      "dest": "/design/experience-v3/frame.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/app-v2(/.*)?",
      "dest": "/app-v2/index.html"
    }
  ]
}
